# Copy to .env and fill in real values. Never commit .env.

# --- Flume Personal Developer client (Flume Portal -> Settings -> API) ---
FLUME_CLIENT_ID=your-flume-client-id
FLUME_CLIENT_SECRET=your-flume-client-secret

# --- Flume account credentials ---
FLUME_USERNAME=you@example.com
FLUME_PASSWORD=your-flume-password

# --- MQTT broker ---
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
# Set MQTT_TLS=1 for a broker that requires TLS; MQTT_CA_FILE points at a
# custom CA bundle (leave unset to use the system trust store). Off by
# default.
MQTT_TLS=0
MQTT_CA_FILE=

# --- Bridge behavior ---
FAST_POLL_INTERVAL=60
SLOW_POLL_INTERVAL=300
ALERT_POLL_INTERVAL=1800
LEAK_HOLD_SECONDS=1800
HA_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=flume
LOG_LEVEL=INFO

# --- Optional: production-error reporting via GitHub repository_dispatch ---
# Leave both unset to disable. See _shared/python-github-error-reporter/README.md.
GITHUB_ERROR_TOKEN=
GITHUB_REPO=
GITHUB_ERROR_ENVIRONMENT=production
